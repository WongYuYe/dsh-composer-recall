# =============================
# OpenClaw Visual Backend config
# =============================

# HTTP server (default: local-only for security)
PORT=8787
HOST=127.0.0.1

# OpenClaw CLI settings
OPENCLAW_BIN=openclaw
OPENCLAW_PROFILE=

# Backend auth key (THIS API server's own key)
# Generate: openssl rand -hex 32
# Frontend must send: x-api-key: <API_KEY>
API_KEY=

# Default true: server refuses startup when API_KEY is empty
REQUIRE_API_KEY=true

# CORS: set your frontend domain in production, e.g. https://panel.example.com
# Avoid * in production.
CORS_ORIGIN=*

# Security toggles
# Keep false in production unless absolutely needed.
ENABLE_EXEC_ENDPOINT=false

# Redact local path/session identifiers from API responses.
REDACT_SENSITIVE_OUTPUT=true

# Usually keep false (avoid leaking executed CLI command strings)
INCLUDE_COMMAND_IN_RESPONSE=false

# Basic rate limit (per-IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# WebSocket status push interval
WS_STATUS_INTERVAL_MS=5000
